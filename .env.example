TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
# Generate each secret independently: openssl rand -hex 48
JWT_SECRET=
CRON_SECRET=
ADMIN_USER=
ADMIN_PASSWORD=
# Optional bcrypt hash takes precedence over ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
CF_ACCOUNT_ID=
CF_ACCESS_KEY_ID=
CF_SECRET_ACCESS_KEY=
CF_BUCKET_NAME=ziatech-images
CF_PUBLIC_DOMAIN=
# Configure Steadfast in Store Settings; these are optional fallbacks.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Optional. The shop assistant works from catalogue facts without Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
